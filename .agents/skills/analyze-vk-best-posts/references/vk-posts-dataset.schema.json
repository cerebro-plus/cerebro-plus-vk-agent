{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vk-posts-dataset.schema.json",
  "title": "VK weekly post analysis dataset",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "run_started_at",
    "timezone",
    "window",
    "source",
    "communities",
    "posts",
    "benchmarks",
    "unavailable",
    "pagination",
    "api_audit",
    "media_audit",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["draft", "confirmed"]},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
    "confirmation_date": {"type": ["string", "null"], "format": "date"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Europe/Moscow"},
    "window": {
      "type": "object",
      "required": ["start", "end", "duration_hours"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "duration_hours": {"const": 168},
        "inclusion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "competitor_set_sha256",
        "competitor_set_status",
        "competitor_count",
        "new_competitor_search_performed"
      ],
      "properties": {
        "competitor_set_path": {"type": "string"},
        "competitor_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "competitor_set_status": {"const": "confirmed"},
        "competitor_count": {"type": "integer", "minimum": 1},
        "new_competitor_search_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "communities": {"type": "array", "minItems": 1},
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "post_id",
          "owner_id",
          "vk_post_id",
          "community_id",
          "community_name",
          "community_vk",
          "competitor_type",
          "date",
          "timestamp",
          "url",
          "text",
          "post_type",
          "poll",
          "giveaway",
          "likes",
          "comments",
          "reposts",
          "views",
          "er",
          "er_status",
          "benchmark",
          "is_best",
          "result",
          "attachments",
          "verified_videos",
          "media",
          "data_status"
        ],
        "properties": {
          "post_id": {"type": "string", "pattern": "^-?\\d+_\\d+$"},
          "owner_id": {"type": "integer"},
          "vk_post_id": {"type": "integer", "minimum": 1},
          "community_id": {"type": "integer", "minimum": 1},
          "community_name": {"type": "string", "minLength": 1},
          "community_vk": {"type": "string", "format": "uri"},
          "competitor_type": {
            "enum": ["Прямой", "Косвенный", "За внимание"]
          },
          "followers": {"type": "integer", "minimum": 0},
          "date": {"type": "string", "format": "date-time"},
          "timestamp": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "format": "uri"},
          "text": {"type": "string"},
          "post_type": {
            "enum": ["Клип", "Видео", "Картинка", "Карусель", "Текстовый пост"]
          },
          "poll": {"type": "boolean"},
          "giveaway": {"type": "boolean"},
          "likes": {"type": "integer", "minimum": 0},
          "comments": {"type": "integer", "minimum": 0},
          "reposts": {"type": "integer", "minimum": 0},
          "views": {"type": "integer", "minimum": 0},
          "er": {"type": ["number", "null"], "minimum": 0},
          "er_status": {
            "enum": ["calculated", "not_calculated_no_views"]
          },
          "benchmark": {"type": ["number", "null"], "minimum": 0},
          "is_best": {"type": "boolean"},
          "result": {
            "enum": ["Лучший пост", "Ниже бенчмарка", "ER не рассчитан"]
          },
          "attachments": {"type": "array"},
          "verified_videos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "outer_type",
                "inner_type",
                "is_clip",
                "verification_status",
                "verification_source"
              ],
              "properties": {
                "outer_type": {"type": "string"},
                "inner_type": {"type": ["string", "null"]},
                "is_clip": {"type": "boolean"},
                "verification_status": {
                  "enum": ["confirmed_clip", "confirmed_video"]
                },
                "verification_source": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "media": {
            "type": "object",
            "required": [
              "images",
              "collage_path",
              "collage_width",
              "collage_height",
              "clip_path",
              "transcription_status",
              "transcript"
            ],
            "properties": {
              "images": {"type": "array"},
              "collage_path": {"type": ["string", "null"]},
              "collage_width": {"type": ["integer", "null"], "minimum": 1},
              "collage_height": {"type": ["integer", "null"], "minimum": 1},
              "clip_path": {"type": ["string", "null"]},
              "transcription_status": {
                "type": ["string", "null"],
                "enum": ["success", "no_speech", "unavailable", null]
              },
              "transcript": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "data_status": {"enum": ["complete", "partial"]}
        },
        "additionalProperties": true
      }
    },
    "benchmarks": {"type": "object"},
    "unavailable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object", "link", "reason", "scope", "post_id"],
        "properties": {
          "object": {"type": "string", "minLength": 1},
          "link": {"type": "string", "format": "uri"},
          "reason": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "post_id": {"type": "string", "pattern": "^-?\\d+_\\d+$"}
        },
        "additionalProperties": false
      }
    },
    "pagination": {"type": "object"},
    "api_audit": {"type": "object"},
    "media_audit": {"type": "object"},
    "validation": {"type": "object"}
  },
  "additionalProperties": true
}
