{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-review.schema.json",
  "title": "Business source review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "collected_at",
    "sources",
    "security"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "collected",
        "partial",
        "failed"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "final_url",
          "label",
          "kind",
          "status",
          "retrieved_at",
          "method",
          "coverage",
          "limitations",
          "content"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "final_url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "vk",
              "website"
            ]
          },
          "status": {
            "enum": [
              "collected",
              "partial",
              "failed"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "content": {
            "type": "object"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_secrets",
        "token_embedded",
        "vk_api_used"
      ],
      "properties": {
        "contains_secrets": {
          "const": false
        },
        "token_embedded": {
          "const": false
        },
        "vk_api_used": {
          "type": "boolean"
        }
      }
    }
  }
}
